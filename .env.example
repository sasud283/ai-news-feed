# Phase 1 RSS ingestion requires no credentials.
# Phase 2: set this in the worker's process environment; .env is not auto-loaded.
OPENAI_API_KEY=replace-with-your-api-key
# Model is fixed to gpt-4o-mini in src/processing/summariser.py.

# Phase 3 worker only. Use Supabase's Postgres connection string with TLS.
# Never prefix this with VITE_ or expose it to the browser.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
# Existing website server authentication (set in hosting environment).
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Browser configuration: public values only. Use the same project as the server.
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Newsletter: server/worker only. Never use VITE_ prefixes for these.
# Keep checkout closed until billing, delivery and the scheduler are tested.
NEWSLETTER_CHECKOUT_ENABLED=false
NEWSLETTER_SEND_ENABLED=false
NEWSLETTER_TEST_ONLY=true
NEWSLETTER_STRIPE_LIVE=false
NEWSLETTER_FROM=TheFullPicture.ai <newsletter@thefullpicture-ai.xyz>
NEWSLETTER_REPLY_TO=thefullpictureai@gmail.com
NEWSLETTER_SITE_URL=https://your-hosted-website.example
NEWSLETTER_LINK_SECRET=replace-with-a-long-random-secret
NEWSLETTER_POSTAL_ADDRESS=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DAILY_MONTHLY=
STRIPE_PRICE_DAILY_YEARLY=
STRIPE_PRICE_WEEKLY_MONTHLY=
STRIPE_PRICE_WEEKLY_YEARLY=
